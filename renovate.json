{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>damacus/renovate-config"
  ],
  "automerge": true,
  "automergeType": "pr",
  "ignoreTests": false,
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchDepNames": ["better-auth", "better-auth-core", "better-auth-seaorm"],
      "groupName": "Better Auth Rust"
    },
    {
      "matchManagers": ["npm"],
      "skipInstalls": false
    },
    {
      "matchManagers": ["cargo"],
      "matchDepNames": ["axum_session", "axum_session_sqlx"],
      "groupName": "Axum sessions"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "ignoreTests": false
  }
}
