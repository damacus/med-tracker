new file mode 100644
index 0000000..22c5a53
--- /dev/null
+++ b/internal/watcher/auto_open_test.go
@@ -0,0 +1,39 @@
+package watcher
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+type openRecorder struct{ opened int }
+
+func (*openRecorder) IsFileOpen(string) bool                     { return false }
+func (r *openRecorder) OpenFile(context.Context, string) error   { r.opened++; return nil }
+func (*openRecorder) NotifyChange(context.Context, string) error { return nil }
+func (*openRecorder) DidChangeWatchedFiles(context.Context, protocol.DidChangeWatchedFilesParams) error {
+	return nil
+}
+
+func TestAutoOpenCanBeDisabledWithoutDisablingWatchEvents(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "reference.rb")
+	if err := os.WriteFile(file, []byte("class Example; end"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, enabled := range []bool{true, false} {
+		client := &openRecorder{}
+		config := DefaultWatcherConfig()
+		config.AutoOpenFiles = enabled
+		w := NewWorkspaceWatcherWithConfig(client, config)
+		w.openMatchingFile(context.Background(), file)
+		if (client.opened == 1) != enabled {
+			t.Fatalf("enabled=%v opened=%d", enabled, client.opened)
+		}
+		if watched, _ := w.isPathWatched(file); !watched {
+			t.Fatal("file changes stopped being watched")
+		}
+	}
+}
