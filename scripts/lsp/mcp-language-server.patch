new file mode 100644
index 0000000..6639c3e
--- /dev/null
+++ b/internal/tools/diagnostics_test.go
@@ -0,0 +1,62 @@
+package tools
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/isaacphi/mcp-language-server/internal/lsp"
+)
+
+func TestDiagnosticsUsesPullReportAndSurfacesErrors(t *testing.T) {
+	for _, scenario := range []string{"error", "full"} {
+		t.Run(scenario, func(t *testing.T) {
+			client, err := lsp.NewClient(os.Args[0], "-test.run=TestDiagnosticServer", "--", scenario)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Cmd.Process.Kill()
+			file := filepath.Join(t.TempDir(), "probe.rs")
+			if err := os.WriteFile(file, []byte("fn main( {"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			text, err := GetDiagnosticsForFile(context.Background(), client, file, 0, false)
+			if scenario == "error" {
+				if err == nil || !strings.Contains(err.Error(), "cancelled") {
+					t.Fatalf("text=%q err=%v", text, err)
+				}
+			} else if err != nil || !strings.Contains(text, "ERROR at L1:C1: expected delimiter") {
+				t.Fatalf("text=%q err=%v", text, err)
+			}
+		})
+	}
+}
+
+func TestDiagnosticServer(t *testing.T) {
+	if len(os.Args) < 3 || os.Args[len(os.Args)-2] != "--" {
+		return
+	}
+	reader := bufio.NewReader(os.Stdin)
+	for {
+		msg, err := lsp.ReadMessage(reader)
+		if err != nil {
+			os.Exit(0)
+		}
+		if msg.Method != "textDocument/diagnostic" {
+			continue
+		}
+		response := &lsp.Message{JSONRPC: "2.0", ID: msg.ID}
+		if os.Args[len(os.Args)-1] == "error" {
+			response.Error = &lsp.ResponseError{Code: -32800, Message: "cancelled"}
+		} else {
+			response.Result = json.RawMessage(`{"kind":"full","items":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":1}},"severity":1,"message":"expected delimiter"}]}`)
+		}
+		if err := lsp.WriteMessage(os.Stdout, response); err != nil {
+			os.Exit(2)
+		}
+	}
+}
