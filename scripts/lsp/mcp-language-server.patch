diff --git a/internal/lsp/transport_test.go b/internal/lsp/transport_test.go
new file mode 100644
index 0000000..6d7c5c7
--- /dev/null
+++ b/internal/lsp/transport_test.go
@@ -0,0 +1,103 @@
+package lsp
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestCallHonoursCancellation(t *testing.T) {
+	c := &Client{stdin: discardCloser{}, handlers: make(map[string]chan *Message)}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- c.Call(ctx, "textDocument/diagnostic", nil, nil) }()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("got %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("request ignored its deadline")
+	}
+}
+
+type discardCloser struct{}
+
+type yieldingWriter struct {
+	mu sync.Mutex
+	bytes.Buffer
+}
+
+func (w *yieldingWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	n, err := w.Buffer.Write(p)
+	w.mu.Unlock()
+	runtime.Gosched()
+	return n, err
+}
+func (*yieldingWriter) Close() error { return nil }
+
+func TestConcurrentMessagesKeepHeadersWithBodies(t *testing.T) {
+	w := &yieldingWriter{}
+	c := &Client{stdin: w}
+	var tasks sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		tasks.Add(1)
+		go func() {
+			defer tasks.Done()
+			if err := c.Notify(context.Background(), "probe", nil); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	tasks.Wait()
+	reader := bufio.NewReader(&w.Buffer)
+	for i := 0; i < 100; i++ {
+		msg, err := ReadMessage(reader)
+		if err != nil || msg.Method != "probe" {
+			t.Fatalf("message %d: %v %v", i, msg, err)
+		}
+	}
+}
+
+func TestLargeStderrDoesNotBlockResponses(t *testing.T) {
+	c, err := NewClient(os.Args[0], "-test.run=TestLargeStderrServer", "--", "lsp-helper")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Cmd.Process.Kill()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	var result bool
+	if err := c.Call(ctx, "probe", nil, &result); err != nil || !result {
+		t.Fatalf("result=%v err=%v", result, err)
+	}
+}
+
+func TestLargeStderrServer(t *testing.T) {
+	if os.Args[len(os.Args)-1] != "lsp-helper" {
+		return
+	}
+	msg, err := ReadMessage(bufio.NewReader(os.Stdin))
+	if err != nil {
+		os.Exit(2)
+	}
+	_, _ = io.WriteString(os.Stderr, strings.Repeat("x", 256*1024)+"\n")
+	if err := WriteMessage(os.Stdout, &Message{JSONRPC: "2.0", ID: msg.ID, Result: json.RawMessage(`true`)}); err != nil {
+		os.Exit(2)
+	}
+	os.Exit(0)
+}
+
+func (discardCloser) Write(p []byte) (int, error) { return io.Discard.Write(p) }
+func (discardCloser) Close() error                { return nil }
