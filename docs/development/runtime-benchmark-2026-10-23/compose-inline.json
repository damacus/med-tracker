          "curl",
          "--fail",
          "--silent",
          "http://127.0.0.1:9000/health"
        ],
        "timeout": "3s",
        "interval": "10s",
        "retries": 20
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 9000,
          "protocol": "tcp"
        }
      ]
    },
    "rails-storage-init": {
      "command": null,
      "entrypoint": [
        "/bin/sh",
        "-c",
        "chown 10001:10001 /data /logs"
      ],
      "image": "rustfs/rustfs:1.0.0-alpha.90",
      "networks": {
        "default": null
      },
      "user": "0:0",
      "volumes": [
        {
          "type": "volume",
          "source": "rails-data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "rails-logs",
          "target": "/logs",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "loco-data": {
      "name": "mt-idle-6577_loco-data"
