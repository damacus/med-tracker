#!/usr/bin/env -S fish --no-config

if test "$argv[1]" = proxy
    if test "$argv[2]" = mktemp
        set -l run_dir (command mktemp $argv[3..-1])
        or exit $status
        echo $run_dir > $CONTRACT_FAKE_RUN_DIR_FILE
        echo $run_dir
    else if test "$argv[2]" = curl
        if set -q CONTRACT_FAKE_TRACE
            if test "$CONTRACT_FAKE_FAIL_STEP" = ready
                echo probe >>$CONTRACT_FAKE_TRACE
                exit 22
            end
            echo ready >>$CONTRACT_FAKE_TRACE
        end
        exit 0
    else if test "$argv[2]" = docker; and set -q CONTRACT_FAKE_COMPOSE_PORT_RESULT
        switch $CONTRACT_FAKE_COMPOSE_PORT_RESULT
            case error
                exit 27
            case empty
                exit 0
            case '*'
                echo $CONTRACT_FAKE_COMPOSE_PORT_RESULT
                exit 0
        end
    else if test "$argv[2]" = docker; and test "$argv[3]" = compose; and contains -- logs $argv
        echo 'Synthetic Rust API error log tail' >&2
        exit 0
    else if test "$argv[2]" = task
        fish (status filename) task $argv[3..-1]
        exit $status
    else if test "$argv[2]" = openssl; and test "$argv[3]" = genpkey; and test "$CONTRACT_FAKE_FAIL_STEP" = apns_key_generation
        exit 42
    else
        command $argv[2..-1]
    end
    exit $status
end

if test "$argv[1]" != task
    exit 2
end

set -l task_name $argv[2]
if test "$task_name" = --force
    set task_name $argv[3]
end

switch $task_name
    case test:exec
        set -q CONTRACT_FAKE_RUN_DIR_FILE
        or exit 62
        set -l run_dir (cat "$CONTRACT_FAKE_RUN_DIR_FILE")
        string match -rq '^tmp/contract-tests/run\.[A-Za-z0-9]{6}$' -- "$run_dir"
        or exit 63
        test -d "$run_dir"; and test -f "$run_dir/owner"
        or exit 64
        set -l project_arg (string match 'CONTRACT_PROJECT=*' -- $argv)
        test (count $project_arg) -eq 1
        or exit 65
        set -l project (string replace 'CONTRACT_PROJECT=' '' -- "$project_arg")
        test (cat "$run_dir/owner") = "$project"
        or exit 66
        echo '{"probe":true}' >"$run_dir/fixture.json"
        exit $status
    case api:contract-source-snapshot
        if set -q CONTRACT_FAKE_TRACE
            echo $task_name >>$CONTRACT_FAKE_TRACE
        end
        if test "$CONTRACT_FAKE_FAIL_STEP" = "$task_name"
            exit 42
        end
        command task $argv[2..-1]
        exit $status
    case api:contract-up api:contract-external-up api:contract-ready api:contract-test api:contract-household-web-test api:contract-openapi-dosages-test api:contract-openapi-people-test api:contract-openapi-sessions-test api:contract-openapi-notifications-test api:contract-openapi-native-tokens-test api:contract-openapi-push-subscriptions-test api:contract-openapi-admin-settings-test api:contract-openapi-person-medication-writes-test api:contract-openapi-schedule-writes-test api:contract-openapi-pause-lifecycle-test api:contract-openapi-dose-occurrences-test api:contract-openapi-review-prompts-test api:contract-openapi-app-tokens-test api:contract-openapi-memberships-test api:contract-openapi-stock-workflows-test api:contract-openapi-audit-logs-test api:contract-openapi-person-grants-test api:contract-openapi-invitations-test api:contract-openapi-profile-test api:contract-openapi-profile-storage-test api:contract-openapi-read-completion-test api:contract-openapi-rate-limit-test api:contract-openapi-reports-test api:contract-openapi-health-events-test api:contract-openapi-exports-test api:contract-openapi-sync-reads-test api:contract-openapi-external-integrations-test api:contract-openapi-portable-writes-test api:contract-openapi-portability-legacy-test api:contract-openapi-sync-batch-legacy-test api:contract-openapi-sync-batch-replay-focus-test api:contract-openapi-replay-legacy-test api:contract-openapi-envelopes-legacy-test api:contract-api-legacy-auth-test api:contract-api-legacy-admin-test api:contract-api-legacy-care-test api:contract-api-legacy-devices-test api:contract-api-legacy-lookup-test api:contract-existing-invitations-test api:contract-openapi-medications-test api:contract-openapi-medications-focused-test api:contract-web-session-test api:contract-web-reads-test api:contract-web-reads-rails-test api:contract-browser-test api:contract-browser-rails api:contract-browser-rust api:contract-image-remove api:contract-subnet-check
        if set -q CONTRACT_FAKE_TRACE
            echo $task_name >>$CONTRACT_FAKE_TRACE
        end
        if test "$task_name" = api:contract-test; and test "$CONTRACT_FAKE_REQUIRE_RELATIVE_CLEANUP" = 1
            test -d "$CONTRACT_FIXTURE_DIR"
            or exit 44
            set -q CONTRACT_RUN_DIR
            and exit 45
            contains -- rust/contract-tests/runner-subnet.compose.yaml (string split : -- "$COMPOSE_FILE")
            or exit 46
        end
        if test "$task_name" = api:contract-up
            set -q CONTRACT_APNS_PRIVATE_KEY
            or exit 54
            string match -q '*BEGIN PRIVATE KEY*' -- "$CONTRACT_APNS_PRIVATE_KEY"
            or exit 55
            string match -q '*END PRIVATE KEY*' -- "$CONTRACT_APNS_PRIVATE_KEY"
            or exit 56
            printf '%s\n' "$CONTRACT_APNS_PRIVATE_KEY" | command openssl pkey -noout > /dev/null 2>&1
            or exit 57
            test -f "$CONTRACT_API_BUILD_CONTEXT/rust/api/Cargo.toml"
            or exit 50
            test -f "$CONTRACT_API_BUILD_CONTEXT/config/nhs_dmd_curated_products.yml"
            or exit 51
            test -f "$CONTRACT_API_BUILD_CONTEXT/vendor/fonts/OFL-1.1.txt"
            or exit 52
            test ! -e "$CONTRACT_API_BUILD_CONTEXT/rust/api/target"
            or exit 53
        end
        if test "$task_name" = api:contract-browser-rust
            if test "$PROFILE_ACCEPTANCE" = true
                test "$CONTRACT_RUST_BROWSER_SCREENSHOT_DIR" = ./docs/screenshots/profile-rust
            else
                test "$CONTRACT_RUST_BROWSER_SCREENSHOT_DIR" = ./docs/screenshots/journey-medication-rust
            end
            or exit 47
            test -d "$CONTRACT_FIXTURE_DIR"
            or exit 48
            contains -- rust/contract-tests/runner.compose.yaml (string split : -- "$COMPOSE_FILE")
            or exit 49
            if test "$CONTRACT_FAKE_REQUIRE_BROWSER_SNAPSHOT" = 1
                set -q CONTRACT_BROWSER_BUILD_CONTEXT
                or begin; echo 'Rust browser build did not inherit its captured source context' >&2; exit 58; end
                test "$CONTRACT_BROWSER_BUILD_CONTEXT" = "$CONTRACT_API_BUILD_CONTEXT/rust/web"
                or begin; echo 'Rust browser build context differs from the captured API web source' >&2; exit 59; end
                test -f "$CONTRACT_BROWSER_BUILD_CONTEXT/Dockerfile.smoke"
                or begin; echo 'Captured browser Dockerfile is missing' >&2; exit 60; end
                for browser_test in (string split ' ' -- "$BROWSER_TEST_FILES")
                    test -f "$CONTRACT_BROWSER_BUILD_CONTEXT/$browser_test"
                    or begin; echo "Captured selected browser test is missing: $browser_test" >&2; exit 61; end
                end
                echo browser-source-snapshot-verified >>$CONTRACT_FAKE_TRACE
            end
        end
        if test "$CONTRACT_FAKE_FAIL_STEP" = "$task_name"
            exit 42
        end
        exit 0
    case contract:cleanup
        if set -q CONTRACT_FAKE_TRACE
            echo cleanup >>$CONTRACT_FAKE_TRACE
        end
        if test "$CONTRACT_FAKE_REQUIRE_RELATIVE_CLEANUP" = 1
            set -l run_dir_arg (string match 'CONTRACT_RUN_DIR=*' -- $argv)
            string match -rq '^CONTRACT_RUN_DIR=tmp/contract-tests/run\.[A-Za-z0-9]{6}$' -- $run_dir_arg
            or exit 43
        end
        exit $CONTRACT_FAKE_CLEANUP_STATUS
    case contract:restart-web
        if set -q CONTRACT_FAKE_TRACE
            echo restart >>$CONTRACT_FAKE_TRACE
        end
        if test "$CONTRACT_FAKE_FAIL_STEP" = restart
            exit 31
        end
    case test:port
        set -l port 43017
        set -l call_number 1
        if set -q CONTRACT_FAKE_TRACE
            if test -f $CONTRACT_FAKE_TRACE
                set -l previous (string match -r '^port$' < $CONTRACT_FAKE_TRACE | count)
                set port (math 43017 + $previous)
                set call_number (math $previous + 1)
            end
            echo port >>$CONTRACT_FAKE_TRACE
        end
        if test "$call_number" = "$CONTRACT_FAKE_FAIL_AT"
            switch $CONTRACT_FAKE_FAIL_STEP
                case port_exit
                    exit 31
                case port_empty
                    exit 0
                case port_text
                    echo unavailable
                    exit 0
                case port_invalid
                    echo 70000
                    exit 0
            end
        end
        echo $port
    case contract:run
        set -l target all
        set -l base_url
        for arg in $argv
            if string match -q 'TEST_TARGET=*' -- $arg
                set target (string replace 'TEST_TARGET=' '' -- $arg)
            else if string match -q 'BASE_URL=*' -- $arg
                set base_url (string replace 'BASE_URL=' '' -- $arg)
            end
        end
        if set -q CONTRACT_FAKE_TRACE
            echo "run:$target:$base_url" >>$CONTRACT_FAKE_TRACE
        end
        if test "$CONTRACT_FAKE_REMOVE_OWNER" = 1
            set -l run_dir (cat $CONTRACT_FAKE_RUN_DIR_FILE)
            echo '{"probe":true}' >$run_dir/fixture.json
            command rm $run_dir/owner
        end
        if test "$target" = "$CONTRACT_FAKE_FAIL_TARGET"
            exit 23
        end
        exit $CONTRACT_FAKE_RUN_STATUS
    case contract:run-web-json-actions-disabled
        for arg in $argv
            if string match -q 'BASE_URL=*' -- $arg
                set -l base_url (string replace 'BASE_URL=' '' -- $arg)
                if set -q CONTRACT_FAKE_TRACE
                    echo "run:web_json_actions_disabled:$base_url" >>$CONTRACT_FAKE_TRACE
                end
            end
        end
        exit $CONTRACT_FAKE_RUN_STATUS
    case 'contract:run*' contract:oauth
        if test "$CONTRACT_FAKE_REMOVE_OWNER" = 1
            set -l run_dir (cat $CONTRACT_FAKE_RUN_DIR_FILE)
            echo '{"probe":true}' >$run_dir/fixture.json
            command rm $run_dir/owner
        end
        exit $CONTRACT_FAKE_RUN_STATUS
end
