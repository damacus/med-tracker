# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
/coverage
/client-tools/target/
/rust/contract-tests/target/

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

# Ignore mkdocs build output
/site/
/.vale/styles/
__pycache__/
*.sqlite3
db/*.sqlite3-*
claude-progress.txt
feedback.txt
pr_description.md

# Lighthouse reports
lighthouse-*
node_modules
.worktrees/
vendor/**/*
!vendor/fonts/
!vendor/fonts/NotoSans-Regular.ttf
!vendor/fonts/OFL-1.1.txt

# Downloaded browser packages
*.deb

# Claude Code session cache
.claude/session-cache/

# Import Files
*.zip

# Mutant incremental result cache
.mutant/
/mobile/android/.gradle/
/mobile/android/.kotlin/
/mobile/android/**/build/
/mobile/android/local.properties
/mobile/android/.idea/
/mobile/android/*.iml
/rust/api/target/
/docs/plans/axum-leptos-port/next-slices/evidence/
/target/
/rails/.bundle
/rails/.env*
/rails/config/master.key
/rails/config/credentials/*.key
/rails/log/*
!/rails/log/.keep
/rails/tmp/*
!/rails/tmp/.keep
!/rails/tmp/pids/
/rails/tmp/pids/*
!/rails/tmp/pids/.keep
!/rails/tmp/storage/
/rails/tmp/storage/*
!/rails/tmp/storage/.keep
/rails/storage/*
!/rails/storage/.keep
/rails/coverage
/rails/public/assets
/rails/app/assets/builds/*
!/rails/app/assets/builds/.keep
/rails/.mutant/
/rails/vendor/**/*
!/rails/vendor/fonts/
!/rails/vendor/fonts/NotoSans-Regular.ttf
!/rails/vendor/fonts/OFL-1.1.txt
