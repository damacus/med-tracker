  "policy:public.account_avatars.account_avatar_depicted_person": {
    "check": null,
    "roles": [
      "med_tracker_app"
    ],
    "using": "(EXISTS ( SELECT 1\n   FROM (((people p\n     JOIN person_access_grants g ON (((g.person_id = p.id) AND (g.household_id = p.household_id))))\n     JOIN household_memberships m ON (((m.id = g.household_membership_id) AND (m.household_id = p.household_id))))\n     JOIN accounts actor ON ((actor.id = m.account_id)))\n  WHERE ((p.account_id = account_avatars.account_id) AND (p.household_id = med_tracker.current_household_id()) AND (m.id = med_tracker.current_membership_id()) AND (m.account_id = med_tracker.current_account_id()) AND ((m.status)::text = 'active'::text) AND (m.revoked_at IS NULL) AND (g.revoked_at IS NULL) AND ((g.expires_at IS NULL) OR (g.expires_at > timezone('UTC'::text, clock_timestamp()))) AND ((g.access_level)::text = ANY ((ARRAY['view'::character varying, 'record'::character varying, 'manage'::character varying])::text[])) AND (actor.status = 2) AND (NOT (EXISTS ( SELECT 1\n           FROM account_lockouts l\n          WHERE ((l.account_id = actor.id) AND (l.deadline > CURRENT_TIMESTAMP))))))))",
    "command": "r",
    "permissive": true
  },
