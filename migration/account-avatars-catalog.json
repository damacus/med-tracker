  "function:public.avatar_key_retained(target_key text)": {
    "acl": [
      "med_tracker_app=X/med_tracker_owner",
      "med_tracker_owner=X/med_tracker_owner"
    ],
    "owner": "med_tracker_owner",
    "definition": "CREATE OR REPLACE FUNCTION public.avatar_key_retained(target_key text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$ SELECT EXISTS (SELECT 1 FROM public.active_storage_blobs WHERE key = target_key)\n  OR EXISTS (SELECT 1 FROM public.account_avatars WHERE key = target_key) $function$\n"
  },
