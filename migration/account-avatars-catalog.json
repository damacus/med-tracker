  "policy:public.account_avatars.account_avatar_self": {
    "check": "((account_id = med_tracker.current_account_id()) AND (EXISTS ( SELECT 1\n   FROM accounts a\n  WHERE ((a.id = account_avatars.account_id) AND (a.status = 2)))) AND (NOT (EXISTS ( SELECT 1\n   FROM account_lockouts l\n  WHERE ((l.account_id = account_avatars.account_id) AND (l.deadline > CURRENT_TIMESTAMP))))))",
    "roles": [
      "med_tracker_app"
    ],
    "using": "((account_id = med_tracker.current_account_id()) AND (EXISTS ( SELECT 1\n   FROM accounts a\n  WHERE ((a.id = account_avatars.account_id) AND (a.status = 2)))) AND (NOT (EXISTS ( SELECT 1\n   FROM account_lockouts l\n  WHERE ((l.account_id = account_avatars.account_id) AND (l.deadline > CURRENT_TIMESTAMP))))))",
