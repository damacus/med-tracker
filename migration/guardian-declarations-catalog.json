  "policy:public.guardian_declarations.guardian_declarations_initial_insert": {
    "check": "((origin_household_id = med_tracker.current_household_id()) AND (statement_version = 1) AND (revision = 1) AND (withdrawn_at IS NULL) AND (EXISTS ( SELECT 1\n   FROM (((accounts a\n     JOIN people guardian ON ((guardian.id = a.person_id)))\n     JOIN household_memberships actor ON ((actor.person_id = guardian.id)))\n     JOIN households h ON ((h.id = actor.household_id)))\n  WHERE ((a.id = med_tracker.current_account_id()) AND (a.id = guardian_declarations.declared_by_account_id) AND (a.person_id = guardian_declarations.guardian_person_id) AND (a.status = 2) AND (guardian.person_type = 0) AND guardian.has_capacity AND (actor.id = med_tracker.current_membership_id()) AND (actor.household_id = guardian_declarations.origin_household_id) AND ((actor.status)::text = 'active'::text) AND (actor.revoked_at IS NULL) AND ((h.status)::text = 'active'::text) AND ((h.lifecycle_state)::text = 'active'::text) AND (NOT (EXISTS ( SELECT 1\n           FROM account_lockouts l\n          WHERE ((l.account_id = a.id) AND (l.deadline > timezone('UTC'::text, clock_timestamp()))))))))) AND (EXISTS ( SELECT 1\n   FROM (people subject\n     JOIN household_memberships m ON ((m.person_id = subject.id)))\n  WHERE ((subject.id = guardian_declarations.subject_person_id) AND (subject.person_type = ANY (ARRAY[1, 2])) AND (NOT subject.has_capacity) AND (m.household_id = guardian_declarations.origin_household_id) AND ((m.status)::text = 'active'::text) AND (m.revoked_at IS NULL)))))",
    "command": "a",
    "permissive": true,
    "roles": [
      "med_tracker_app"
    ],
    "using": null
  },
