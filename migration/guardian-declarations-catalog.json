  "function:med_tracker.guardian_declaration_one_way()": {
    "acl": [
      "med_tracker_owner=X/med_tracker_owner"
    ],
    "definition": "CREATE OR REPLACE FUNCTION med_tracker.guardian_declaration_one_way()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n  IF TG_OP='INSERT' THEN\n    NEW.declared_at:=pg_catalog.clock_timestamp();\n    RETURN NEW;\n  END IF;\n  IF TG_OP='DELETE' THEN\n    RAISE EXCEPTION USING ERRCODE='23514',MESSAGE='Guardian declaration provenance is retained';\n  END IF;\n  IF (pg_catalog.to_jsonb(NEW)-ARRAY['withdrawn_at','revision'])\n       IS DISTINCT FROM\n     (pg_catalog.to_jsonb(OLD)-ARRAY['withdrawn_at','revision']) THEN\n    RAISE EXCEPTION USING ERRCODE='23514',MESSAGE='Guardian declaration identity is immutable';\n  END IF;\n  IF OLD.withdrawn_at IS NOT NULL THEN\n    IF NEW IS DISTINCT FROM OLD THEN\n      RAISE EXCEPTION USING ERRCODE='23514',MESSAGE='Guardian declaration withdrawal is final';\n    END IF;\n    RETURN NEW;\n  END IF;\n  IF NEW.withdrawn_at IS NULL OR NEW.revision<>OLD.revision+1 THEN\n    RAISE EXCEPTION USING ERRCODE='23514',MESSAGE='Invalid guardian declaration transition';\n  END IF;\n  NEW.withdrawn_at:=pg_catalog.clock_timestamp();\n  IF NEW.withdrawn_at<OLD.declared_at THEN\n    RAISE EXCEPTION USING ERRCODE='23514',MESSAGE='Invalid guardian declaration clock order';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n",
    "owner": "med_tracker_owner"
  },
