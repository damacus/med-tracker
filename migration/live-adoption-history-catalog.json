    "policy:public.shared_schedule_adoption_facts.adoption_fact_fixed_validator": {
      "check": null,
      "command": "r",
      "permissive": true,
      "roles": [
        "med_tracker_owner"
      ],
      "using": "((household_id = med_tracker.current_household_id()) AND ((medication_take_id)::text = current_setting('med_tracker.sharing_take_id'::text, true)))"
    },
    "policy:public.shared_schedule_adoption_facts.adoption_fact_local_insert": {
      "check": "((household_id = med_tracker.current_household_id()) AND med_tracker.sharing_clinical_authority(person_id) AND (EXISTS ( SELECT 1\n   FROM (schedules source\n     JOIN person_schedules plan ON (((plan.id)::text = (shared_schedule_adoption_facts.person_schedule_id)::text)))\n  WHERE ((source.id = shared_schedule_adoption_facts.source_schedule_id) AND (source.household_id = shared_schedule_adoption_facts.household_id) AND (source.person_id = shared_schedule_adoption_facts.person_id) AND (source.person_schedule_id IS NULL) AND (source.execution_ended_at IS NULL) AND (plan.origin_schedule_id = source.id) AND (plan.origin_household_id = source.household_id) AND (plan.person_id = source.person_id)))))",
      "command": "a",
      "permissive": true,
      "roles": [
        "med_tracker_app"
      ],
      "using": null
    },
    "policy:public.shared_schedule_adoption_facts.adoption_fact_local_read": {
      "check": null,
      "command": "r",
      "permissive": true,
      "roles": [
        "med_tracker_app"
      ],
      "using": "((household_id = med_tracker.current_household_id()) AND med_tracker.sharing_household_actor(household_id, false))"
    },
    "relation:public.shared_schedule_adoption_facts": {
      "access_method": "heap",
      "acl": [
        "med_tracker_app=ar/med_tracker_owner",
