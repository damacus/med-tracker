+/// A native task's executable and arguments, or an explicitly requested shell job.
+#[derive(Clone, Debug)]
+pub enum JobCommand {
+    /// Execute the application directly without shell interpretation.
+    NativeTask {
+        /// Application executable, including any spaces or non-Unicode path bytes.
+        executable: PathBuf,
+        /// Separate CLI arguments; shell metacharacters remain literal.
+        arguments: Vec<String>,
+    },
+    /// Execute a command through the platform shell only when `shell: true`.
+    Shell(String),
+}
+
+fn native_arguments(run: &str) -> io::Result<Vec<String>> {
+    shlex::split(run)
+        .filter(|arguments| {
+            arguments.first().is_some_and(|name| !name.is_empty())
+                && arguments.iter().all(|argument| !argument.contains('\0'))
+        })
+        .ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "native scheduler task requires a task name, balanced quotes and no NUL bytes",
+            )
+        })
+}
